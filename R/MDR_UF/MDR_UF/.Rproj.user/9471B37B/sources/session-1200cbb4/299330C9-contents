Making one MGE dataframe
```{r}
#files
MGE_MDR_files <- paste(MDR_IDs, ".contig.fasta.mobileOG.Alignment.Out.csv", sep = "")
MGE_MDR <- list()

#seperates Ecoli AMR from MDR AMR
for (x in MGE_MDR_files) {
  file_path <- file.path(MGE_folder, x)
  if (file.exists(file_path)) {
   MGE_MDR[[x]] <- read.table(file_path, header = TRUE, sep = ",", fill = TRUE, comment.char = "")
 }
}

#removing empty mge files
removed_dfs <- names(MGE_MDR)[sapply(MGE_MDR, nrow) < 1]
if (length(removed_dfs) > 0) {
  cat("Isolates that have no MGE genes detected:", paste(removed_dfs, collapse = ", "), "\n")
} else {
  cat("All MDR isolates contained MGE genes")
}

# Filter the list to remove data frames with less than 1 row
MGE_MDR <- Filter(function(df) nrow(df) >= 1, MGE_MDR)


# Combine dataframes and add a column indicating their origin
combined_MGE_MDR <- map_dfr(names(MGE_MDR), function(df_name) {
  MGE_MDR[[df_name]] %>%
    mutate(across(everything(), as.character), # Convert specific column to character
           source = sub(".contig.fasta.mobileOG.Alignment.Out.csv", "", df_name))
})

combined_MGE_MDR <- combined_MGE_MDR %>% filter(source %in% MDR_IDs)

#filtering out "Only in Aclame" hits
ACLAME <- as.list(mapping_df$mobileOG.Entry.Name[(mapping_df$MGE_Class == "Only detected in ACLAME")])

combined_MGE_MDR <- combined_MGE_MDR %>% filter(!mobileOG.ID %in% ACLAME)

#dereplicate 
MGE_data <- combined_MGE_MDR %>%
  group_by(Specific.Contig, ORF_Start, source) %>%
  slice_max(order_by = Bitscore, with_ties = FALSE) %>%
  ungroup()

#matching
MGE_data <- merge(MGE_data, mapping_df, by.x = "mobileOG.ID", by.y = "mobileOG.Entry.Name")
```

#classification
```{r}
#splitting the Levels
classification[c("domain", "phylum", "class", 
                      "order", "family", "genus", "species")] <- do.call(rbind,
                                                                         strsplit(classification$classification, ";"))

#fix names 
classification$genus <- sub("g__Pseudomonas_E", "g__Pseudomonas", classification$genus)
classification$genus <- sub( "g__Providencia_C","g__Providencia", classification$genus)

classification$genus <- gsub("g__", "", classification$genus)
classification$species <- gsub("s__", "", classification$species)
classification$phylum <- gsub("p__", "", classification$phylum)

#Indicate that the two unclassified Chryseobacterium species are different species (making the A and B)
#### We determined that these were different species from dRep. 
#### NO other unknown species with same genus were found to be different species

classification$clean_sp[classification$Isolate_ID == "UF-290"] <- "Chryseobacterium sp (A)"
classification$clean_sp[classification$Isolate_ID == "UF-81"] <- "Chryseobacterium sp (B)"

#combining Pseduomonas and Providencia to be all one genus (GTDB-tk database specification we will obmit)
Pseduomonas <- c("g__Pseudomonas", "g__Pseudomonas_E")
Providencia <- c("g__Providencia", "g__Providencia_C")

#count
genus_freq <- as.data.frame(table(classification$genus))

#rename columns
colnames(genus_freq) <- c("genus", "Count")

#merge with original dataframe to add Phylum
genus_freq <- merge(genus_freq, classification[, c("genus", "phylum")], by = "genus", all.x = TRUE)

#remove duplicate rows
genus_freq <- genus_freq[!duplicated(genus_freq$genus), ]

#reorder so that genus and phylum line up properly 
genus_freq <- genus_freq[order(genus_freq$phylum),]

#merge with metadata
classification2 <- classification %>% select(Isolate_ID, classification, clean_sp, domain,
                                            phylum, class, order, family, genus, species)

Class_metadata <- merge(classification2, metadata, by = "Isolate_ID")
