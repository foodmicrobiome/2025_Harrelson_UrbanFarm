Making AMRFinderPlus results into one dataframe with added Isolate_ID column
```{r}
#files
MDR_IDs <- metadata$Isolate_ID

amr_MDR_files <- paste(MDR_IDs, "_amr", sep = "")
amr_MDR <- list()

#loop to add all files in folder to one R object
for (x in amr_MDR_files) {
  file_path <- file.path(AMRF_folder, x)
  if (file.exists(file_path)) {
   amr_MDR[[x]] <- read.table(file_path, header = TRUE, sep = "\t", fill = TRUE)
 }
}

#removes files with zero hits and say which have zero
removed_dfs <- names(amr_MDR)[sapply(amr_MDR, nrow) < 1]
if (length(removed_dfs) > 0) {
  cat("Isolates that have no AMR genes detected:", paste(removed_dfs, collapse = ", "), "\n")
} else {
  cat("All MDR isolates contained AMR genes according to AMR finder.\n")
}

#combine dataframes and add a column indicating their origin
combined_AMR_MDR <- map_dfr(names(amr_MDR), function(df_name) {
  amr_MDR[[df_name]] %>%
    mutate(across(everything(), as.character), # Convert specific column to character
           "Isolate_ID" = sub("_amr", "", df_name))
})


```

