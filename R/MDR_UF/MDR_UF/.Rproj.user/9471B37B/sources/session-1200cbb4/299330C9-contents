    abs(CARD_data$Stop - amr_row$Stop) <= 100,
  ]

  if (nrow(card_matches) > 0) {
    for (j in 1:nrow(card_matches)) {
      matched_hits[[length(matched_hits) + 1]] <- data.frame(
        Isolate_ID = amr_row$Isolate_ID,
