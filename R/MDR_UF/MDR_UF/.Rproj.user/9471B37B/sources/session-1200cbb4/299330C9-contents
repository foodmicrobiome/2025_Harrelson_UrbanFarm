#subset AMR from Virulence and Stress genes
AMR_data <- AMRfinder_data %>%
  filter(Element.type %in% "AMR")

other_genetypes <- c("STRESS", "VIRULENCE")
  
Oth_gene_data <- AMRfinder_data %>%
  filter(Element.type %in% other_genetypes)

#make AMR df for heatmap
AMR_heat_matrix <- AMR_data %>%
  select(Gene.symbol, new_lab) %>%
  distinct() %>%                           # remove duplicates if any
  mutate(present = 1) %>%                  # assign presence as 1
  tidyr::pivot_wider(names_from = new_lab, values_from = present, values_fill = 0) %>%
  as.data.frame()

#adds back missing isolates that didnt have AMRFinder genes
missing_labs <- setdiff(all_new_labs, colnames(AMR_heat_matrix))
for (lab in missing_labs) {
  AMR_heat_matrix[[lab]] <- 0
}

# Set Gene.symbol as rownames and remove the column
rownames(AMR_heat_matrix) <- AMR_heat_matrix$Gene.symbol
AMR_heat_matrix$Gene.symbol <- NULL

#clean up gene names
for (i in 1:nrow(AMR_heat_matrix)) {
  val <- rownames(AMR_heat_matrix)[i]
    rownames(AMR_heat_matrix)[i] <- strsplit(val, " ")[[1]][1]
}

#other gene matrix for virulecne and metal genes :)

Oth_gene_matrix <- Oth_gene_data %>%
  select(Gene.symbol, new_lab) %>%
  distinct() %>%                           # remove duplicates if any
  mutate(present = 1) %>%                  # assign presence as 1
  tidyr::pivot_wider(names_from = new_lab, values_from = present, values_fill = 0) %>%
  as.data.frame()

