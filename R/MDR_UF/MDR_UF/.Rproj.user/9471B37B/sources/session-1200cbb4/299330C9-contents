for (lab in missing_labs) {
  Oth_gene_matrix[[lab]] <- 0
}

# Set Gene.symbol as rownames and remove the column
rownames(Oth_gene_matrix) <- Oth_gene_matrix$Gene.symbol
Oth_gene_matrix$Gene.symbol <- NULL

