#AMR Class matrix
Class_matrix <- avg_genotype_A %>%
  select(Isolate_ID, Class, clean_sp) %>%
  distinct() %>%  # one row per Isolate-Class-Species
  mutate(present = 1) %>%
  distinct(Isolate_ID, Class, clean_sp, .keep_all = TRUE) %>%
  group_by(Class, clean_sp) %>%
  summarise(n_present = sum(present), .groups = "drop") %>%
  left_join(avg_genotype_A %>%
              select(Isolate_ID, clean_sp) %>%
              distinct() %>%
              count(clean_sp, name = "total_isolates"),
            by = "clean_sp") %>%
